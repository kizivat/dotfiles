#!/usr/bin/env zsh

PACKAGES=(
		private
		aerospace
		bin
		cmux
		ghostty
		git
		homebrew
		macos-defaults
		nvim
		oh-my-posh
		tmux
		yazi
		zsh
)

RESTOW=false
STOW_FLAGS=()

for arg in "$@"; do
		case "$arg" in
				-R|--restow)
						RESTOW=true
						STOW_FLAGS+=(--restow)
						;;
				*)
						STOW_FLAGS+=("$arg")
						;;
		esac
done

for package in $PACKAGES; do
		echo "Processing $package..."

		# Run install script if it exists (skipped when restowing)
		if [[ "$RESTOW" == false ]] && [ -f "$package/install.sh" ]; then
				echo "Running $package/install.sh..."
				if [ -x "$package/install.sh" ]; then
						./$package/install.sh
				else
						chmod +x "$package/install.sh"
						./$package/install.sh
				fi
		fi

		# Stow package
		echo "Stowing $package..."
		stow --target=$HOME --ignore="(\.DS_Store|install\.sh|README\.md)" $package $STOW_FLAGS
done
